#!/usr/bin/env sh
# Pre-commit format check.
#
# We deliberately do NOT use lint-staged here. lint-staged stashes
# unstaged changes between formatter runs to keep the check scoped to
# what's actually being committed; on Windows that stash/unstash dance
# intermittently races with prettier and trips ENOENT.
#
# Instead: run prettier across the whole repo using --cache so unchanged
# files are skipped. Empirically this is ~1s on a warm cache and ~5s cold,
# vs ~3-10s for lint-staged with stash overhead — and it never flakes.
#
# Lint + typecheck run in CI; the hook only enforces format. That matches
# the principle that pre-commit should be fast (< 5s) so it doesn't get
# in the way of a quick fix.

pnpm exec prettier --check --cache "**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}"
