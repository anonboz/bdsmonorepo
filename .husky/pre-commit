#!/usr/bin/env sh
# Pre-commit format check. Runs prettier across the repo (the npm workspace lives
# at the root). --cache skips unchanged files (~1s warm). Lint + typecheck run in
# CI; the hook only enforces format so it stays fast.

npx --no-install prettier --check --cache "**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}"
