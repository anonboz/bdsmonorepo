// Single source of truth for the data model. See packages/db/CLAUDE.md for
// rules — most importantly: migrations are forward-only, money is integer
// minor units + currency, every table has id/createdAt/updatedAt.

generator client {
  provider = "prisma-client-js"
  // Default output → @prisma/client's own node_modules/.prisma/client.
  // With pnpm this is the only setup that lets `Prisma.HouseGetPayload`,
  // `Prisma.validator` etc. resolve correctly from consumer packages.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (mirrored in @repo/shared) ---------------------------

enum Role {
  ADMIN
  OWNER
  TENANT
  PARTNER
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED
}

enum RentCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum BillLineKind {
  RENT
  DEPOSIT
  UTILITY_ELECTRICITY
  UTILITY_WATER
  UTILITY_INTERNET
  UTILITY_OTHER
  SERVICE_FEE
  LATE_FEE
  ADJUSTMENT
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  VNPAY
  MOMO
  MANUAL
}

enum TicketStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketCategory {
  REPAIR
  REPORT
  COMPLAINT
  REQUEST
  OTHER
}

enum CampaignStatus {
  DRAFT
  PENDING
  LIVE
  CLOSED
  REJECTED
  EXPIRED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  RATED
  CANCELLED
}

enum PayoutEntryKind {
  CHARGE
  COMMISSION
  PAYOUT
}

enum PayoutEntryStatus {
  PENDING
  HELD
  RELEASED
  DISBURSED
}

enum PayoutDisbursementMethod {
  MANUAL_BANK_TRANSFER
  STRIPE_CONNECT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum HouseModerationStatus {
  OK
  FLAGGED
  REJECTED
}

enum RatingMilestone {
  MOVE_IN
  MID_LEASE
  MOVE_OUT
}

enum RatingDirection {
  TENANT_TO_OWNER
  OWNER_TO_TENANT
}

enum JobRatingDirection {
  OWNER_TO_PARTNER
  PARTNER_TO_OWNER
}

// ---------- Core identity ----------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified Boolean   @default(false)
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  displayName   String    @db.VarChar(120)
  image         String?
  roles         Role[]    @default([])
  kycStatus     KycStatus @default(NONE)
  isSuspended   Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Better-Auth artifacts
  sessions      Session[]
  accounts      Account[]
  verifications Verification[]

  // Domain relations
  ownedHouses             House[]                  @relation("HouseOwner")
  tenantLeases            Lease[]                  @relation("LeaseTenant")
  ownerLeases             Lease[]                  @relation("LeaseOwner")
  applications            Application[]
  ticketsRaised           Ticket[]                 @relation("TicketReporter")
  ticketsAssigned         Ticket[]                 @relation("TicketAssignee")
  ticketMessages          TicketMessage[]          @relation("TicketMessageAuthor")
  ratingsGiven            LeaseRating[]            @relation("RatingRater")
  ratingsReceived         LeaseRating[]            @relation("RatingRated")
  jobRatingsGiven         JobRating[]              @relation("JobRatingRater")
  jobRatingsReceived      JobRating[]              @relation("JobRatingRated")
  partnerProfile          PartnerProfile?
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLog                AuditLog[]
  mediaAssets             MediaAsset[]

  @@index([deletedAt])
  @@index([createdAt])
}

// Better-Auth session storage. Refresh-token rotation happens here.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// OAuth / OTP provider account links. Kept generic for Better-Auth.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Short-lived verification artifacts (OTP codes, magic-link tokens).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier, value])
  @@index([expiresAt])
}

// ---------- Property domain --------------------------------------------

model House {
  id          String  @id @default(cuid())
  ownerId     String
  owner       User    @relation("HouseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(2000)

  // Address (denormalized JSON for v1; can be normalized later if needed)
  addressLine1 String  @db.VarChar(200)
  addressLine2 String? @db.VarChar(200)
  city         String  @db.VarChar(100)
  state        String? @db.VarChar(100)
  postalCode   String? @db.VarChar(20)
  country      String  @db.Char(2)

  lat Float?
  lng Float?

  isPublished Boolean @default(false)

  moderationStatus    HouseModerationStatus @default(OK)
  moderationReason    String?               @db.VarChar(500)
  moderationDecidedAt DateTime?
  /// Admin user id at decision time. Frozen — admin user lookup happens
  /// on read if a name is needed (rare in v1).
  moderationDecidedBy String?

  units Unit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, deletedAt])
  @@index([country, city])
  @@index([isPublished, deletedAt])
  @@index([moderationStatus, createdAt])
}

model Unit {
  id        String     @id @default(cuid())
  houseId   String
  house     House      @relation(fields: [houseId], references: [id], onDelete: Cascade)
  label     String     @db.VarChar(60)
  status    UnitStatus @default(VACANT)
  floor     Int?
  sqm       Int?
  bedrooms  Int?
  bathrooms Int?

  leases    Lease[]
  campaigns Campaign[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([houseId, label])
  @@index([status])
}

model Lease {
  id       String @id @default(cuid())
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenantId String
  tenant   User   @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  ownerId  String
  owner    User   @relation("LeaseOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  status        LeaseStatus @default(DRAFT)
  rentCycle     RentCycle   @default(MONTHLY)
  rentAmount    Int // minor units
  depositAmount Int // minor units
  currency      String      @db.Char(3)

  startDate DateTime
  endDate   DateTime?

  terminationReason String? @db.VarChar(500)

  bills   Bill[]
  tickets Ticket[]
  ratings LeaseRating[]

  /// Back-reference for application → lease provenance (Phase 4.4).
  application Application? @relation("ApplicationLease")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, status])
  @@index([ownerId, status])
  @@index([unitId, status])
}

// ---------- Billing & payments -----------------------------------------

model Bill {
  id      String @id @default(cuid())
  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  /// Stable key built from `${rentCycle}:${periodStart}` (e.g. `MONTHLY:2026-06-01`).
  /// Together with `leaseId` it gates duplicate generation so a re-fired cron
  /// or retried BullMQ job can't create a second bill for the same period.
  idempotencyKey String @db.VarChar(64)

  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime
  issuedAt    DateTime?

  status   BillStatus @default(DRAFT)
  subtotal Int // minor units
  total    Int // minor units (subtotal + line adjustments)
  currency String     @db.Char(3)

  lines    BillLine[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, idempotencyKey])
  @@index([leaseId, status])
  @@index([status, dueDate])
}

model BillLine {
  id       String       @id @default(cuid())
  billId   String
  bill     Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  kind     BillLineKind
  label    String       @db.VarChar(200)
  amount   Int // minor units (can be negative for adjustments)
  quantity Int          @default(1)
  meta     Json?

  createdAt DateTime @default(now())

  @@index([billId])
}

model Payment {
  id                  String          @id @default(cuid())
  billId              String
  bill                Bill            @relation(fields: [billId], references: [id], onDelete: Restrict)
  /// Minor units. **Signed** — refund rows carry a negative amount
  /// and link back via `refundOfPaymentId`. Bill recompute sums
  /// SUCCEEDED rows so refunds net naturally.
  amount              Int
  currency            String          @db.Char(3)
  status              PaymentStatus   @default(PENDING)
  provider            PaymentProvider
  /// Session / checkout / IPN-time reference (Stripe session id,
  /// VNPay TxnRef, MANUAL bank reference). Set by the request that
  /// initiated the charge.
  providerRef         String?
  /// Settled-transaction reference, populated by the webhook handlers
  /// when the payment confirms — Stripe PaymentIntent id, VNPay
  /// `vnp_TransactionNo`. Required to issue a refund via the
  /// provider API.
  providerCaptureRef  String?
  /// Original provider-side transaction timestamp. For VNPay this is
  /// the IPN's `vnp_PayDate` lifted to a `Date`; required to echo
  /// back on refund (VNPay's `vnp_TransactionDate` parameter).
  /// NULL for pre-9.2 captures and MANUAL / Stripe payments
  /// (Stripe refunds via PaymentIntent don't need a date).
  providerCaptureDate DateTime?
  failureReason       String?         @db.VarChar(500)
  /// Free-form note set when recording a MANUAL payment — bank,
  /// reference number, anything the owner wants on the audit trail.
  /// Intentionally kept out of the audit log meta to avoid mirroring
  /// PII-shaped text into a second store.
  note                String?         @db.VarChar(500)
  receivedAt          DateTime?

  /// Points to the original SUCCEEDED Payment a refund row reverses.
  /// NULL on regular charges. Self-relation; SetNull on delete keeps
  /// refunds intact if the original is ever (incorrectly) removed.
  refundOfPaymentId String?
  refundOf          Payment?  @relation("PaymentRefund", fields: [refundOfPaymentId], references: [id], onDelete: SetNull)
  refunds           Payment[] @relation("PaymentRefund")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerRef])
  @@index([billId, status])
  @@index([status])
  @@index([refundOfPaymentId])
}

// ---------- Tickets ----------------------------------------------------

model Ticket {
  id         String  @id @default(cuid())
  leaseId    String
  lease      Lease   @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  reporterId String
  reporter   User    @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  category TicketCategory
  status   TicketStatus   @default(OPEN)
  title    String         @db.VarChar(200)
  body     String         @db.VarChar(4000)

  resolvedAt DateTime?
  closedAt   DateTime?

  serviceJobs ServiceJob[]
  messages    TicketMessage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([leaseId, status])
  @@index([reporterId, status])
  @@index([assigneeId, status])
  @@index([status, createdAt])
}

model LeaseRating {
  id        String          @id @default(cuid())
  leaseId   String
  lease     Lease           @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User            @relation("RatingRater", fields: [raterId], references: [id], onDelete: Restrict)
  ratedId   String
  rated     User            @relation("RatingRated", fields: [ratedId], references: [id], onDelete: Restrict)
  direction RatingDirection
  milestone RatingMilestone

  /// 1..5. Range enforced by Zod at the API boundary.
  score   Int
  comment String? @db.VarChar(2000)

  createdAt DateTime @default(now())

  /// One rating per (lease, direction, milestone). Stops double-submit and
  /// makes "have I rated this?" a single index hit.
  @@unique([leaseId, direction, milestone])
  @@index([ratedId, createdAt])
  @@index([leaseId])
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  /// Role the author held when the message was written. Frozen at write time
  /// so a later role change does not re-attribute the message.
  authorRole Role
  body       String @db.VarChar(4000)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId])
}

// ---------- Campaigns & applications -----------------------------------

model Campaign {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  /// Denormalized from `unit.house.ownerId` so we can index owner-side
  /// queries without a join. Frozen on create.
  ownerId String

  title       String         @db.VarChar(200)
  body        String         @db.VarChar(4000)
  price       Int // minor units
  currency    String         @db.Char(3)
  status      CampaignStatus @default(DRAFT)
  publishedAt DateTime?
  expiresAt   DateTime?

  /// Image URLs. v1 stores externally-hosted URLs; an S3 upload endpoint
  /// lands when storage is wired (Phase 4.3 or later).
  photos String[] @default([])

  moderationReason    String?   @db.VarChar(500)
  moderationDecidedAt DateTime?
  moderationDecidedBy String?

  applications Application[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, publishedAt])
  @@index([unitId, status])
  @@index([ownerId, status])
}

model Application {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User     @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  /// Denormalized from `campaign.unit.house.ownerId` so owner-side
  /// queries don't need a three-level join. Frozen on create.
  ownerId String

  status  ApplicationStatus @default(SUBMITTED)
  message String?           @db.VarChar(2000)

  decidedAt       DateTime?
  decidedBy       String?
  rejectionReason String?   @db.VarChar(500)

  /// Lease created on accept. One application → at most one lease.
  createdLeaseId String? @unique
  createdLease   Lease?  @relation("ApplicationLease", fields: [createdLeaseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, applicantId])
  @@index([applicantId, status])
  @@index([campaignId, status])
  @@index([ownerId, status])
}

// ---------- Partner marketplace ----------------------------------------

model PartnerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String  @db.VarChar(200)
  bio          String? @db.VarChar(2000)
  serviceArea  String? @db.VarChar(500) // free-form for v1; later GIS

  kycStatus KycStatus @default(NONE)

  /// Stripe Express account id (`acct_*`). Set the first time a
  /// partner clicks "Connect with Stripe". Reused on subsequent
  /// onboarding sessions — partners can re-onboard a partially
  /// completed account without ever creating a second `acct_*`.
  stripeConnectAccountId String? @unique @db.VarChar(60)

  /// Snapshot of Stripe's `charges_enabled && payouts_enabled` state.
  /// Kept fresh by the `account.updated` webhook. The admin payout
  /// flow gates STRIPE_CONNECT disbursement on `ACTIVE` here.
  stripeConnectStatus StripeConnectStatus @default(NOT_STARTED)

  /// First moment the account flipped to ACTIVE. Stays set even if
  /// the partner is later RESTRICTED — useful for tenure metrics.
  stripeConnectOnboardedAt DateTime?

  services Service[]
  jobs     ServiceJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum StripeConnectStatus {
  /// No `acct_*` created yet — the partner hasn't started onboarding.
  NOT_STARTED
  /// Account exists; partner has not completed all of Stripe's
  /// requirements (KYC, bank, ToS) — `charges_enabled` is false.
  ONBOARDING
  /// `charges_enabled && payouts_enabled` — ready for transfers.
  ACTIVE
  /// Stripe revoked the account (KYC fail, account closed, etc.).
  RESTRICTED
}

model Service {
  id        String         @id @default(cuid())
  partnerId String
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(200)
  description String? @db.VarChar(2000)
  basePrice   Int // minor units
  currency    String  @db.Char(3)
  isActive    Boolean @default(true)

  jobs ServiceJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([partnerId, isActive])
}

model ServiceJob {
  id        String         @id @default(cuid())
  partnerId String
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  serviceId String?
  service   Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  ticketId  String?
  ticket    Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  /// Denormalized from the booking owner. Frozen on create — direct
  /// bookings set this from the authenticated owner; ticket-routed
  /// bookings (5.3) set it from the ticket's lease owner.
  ownerId String

  /// Optional unit context. Direct bookings can leave this null.
  unitId String?

  /// Owner's free-form request note.
  description String? @db.VarChar(2000)

  status       JobStatus @default(REQUESTED)
  quotedAmount Int? // minor units
  finalAmount  Int?
  currency     String?   @db.Char(3)

  cancelReason String?   @db.VarChar(200)
  /// Actor user id who cancelled.
  cancelledBy  String?
  scheduledFor DateTime?
  completedAt  DateTime?

  /// Partner-uploaded proof of work URLs. Populated on COMPLETED.
  proofPhotos String[] @default([])

  ledgerEntries JobLedgerEntry[]
  ratings       JobRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, status])
  @@index([ownerId, status])
  @@index([ticketId])
  @@index([status, createdAt])
}

/// Per-job financial accruals. Three rows per COMPLETED job —
/// CHARGE (owner debit), COMMISSION (platform credit), PAYOUT
/// (partner credit). Sum is zero by construction; that's the
/// "ledger entries balance" invariant from the Phase 5 acceptance.
model JobLedgerEntry {
  id    String     @id @default(cuid())
  jobId String
  job   ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  kind   PayoutEntryKind
  status PayoutEntryStatus @default(PENDING)

  /// Minor units. Signed: negative for CHARGE, positive for
  /// COMMISSION and PAYOUT.
  amount   Int
  currency String @db.Char(3)

  /// For CHARGE: the owner. For PAYOUT: the partner's user id.
  /// For COMMISSION: null (platform is the implicit account).
  accountUserId String?

  /// Only set on PAYOUT entries. Sweeper flips status → RELEASED
  /// when `cooldownUntil <= now`.
  cooldownUntil DateTime?
  releasedAt    DateTime?

  /// Set when an admin marks the row DISBURSED (Phase 7.6). The
  /// reference is the bank transfer id / wire id / Stripe transfer
  /// id; the method enum records how the money moved.
  disbursedAt        DateTime?
  disbursementRef    String?                   @db.VarChar(200)
  disbursementMethod PayoutDisbursementMethod?
  /// Admin user id that marked the row DISBURSED. Frozen at write
  /// time; matches the `cancelledBy` text-id pattern elsewhere.
  disbursedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, kind])
  @@index([accountUserId, status])
  @@index([status, cooldownUntil])
  @@index([status, disbursedAt])
}

/// Post-completion ratings between an owner and a partner on a single
/// `ServiceJob`. One row per direction per job — `OWNER_TO_PARTNER` is
/// the owner rating the partner, `PARTNER_TO_OWNER` the reverse.
model JobRating {
  id        String             @id @default(cuid())
  jobId     String
  job       ServiceJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User               @relation("JobRatingRater", fields: [raterId], references: [id], onDelete: Restrict)
  ratedId   String
  rated     User               @relation("JobRatingRated", fields: [ratedId], references: [id], onDelete: Restrict)
  direction JobRatingDirection

  /// 1..5. Range enforced by Zod at the API boundary.
  score   Int
  comment String? @db.VarChar(2000)

  createdAt DateTime @default(now())

  /// One rating per (job, direction). Stops double-submit and makes
  /// "have I rated this?" a single index hit.
  @@unique([jobId, direction])
  @@index([ratedId, createdAt])
  @@index([jobId])
}

// ---------- Cross-cutting ----------------------------------------------

model Notification {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       NotificationChannel
  topic         String              @db.VarChar(120)
  title         String              @db.VarChar(200)
  body          String?             @db.VarChar(2000)
  data          Json?
  readAt        DateTime?
  sentAt        DateTime?
  /// Set by the notifications worker when a send attempt threw past
  /// BullMQ's max retries. `sentAt IS NULL AND failureReason IS NOT
  /// NULL` is the "stuck delivery" condition ops greps for.
  failureReason String?             @db.VarChar(2000)

  /// Phase 10.2 — number of times the stuck-notifications sweeper has
  /// re-enqueued this row. Distinct from BullMQ's per-job attempts;
  /// only the sweeper bumps this so the counter reflects "how many
  /// rescues did this row need" rather than "how many tries the
  /// worker made on a single job."
  retryCount Int @default(0)

  /// Phase 10.2 — set by the sweeper each time it touches the row.
  lastAttemptAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  /// Phase 10.2 — supports the sweeper's
  /// `sentAt IS NULL AND failureReason IS NULL AND createdAt < ?`
  /// scan. Non-partial because Prisma's partial index syntax
  /// doesn't play well with our migration generator path.
  @@index([createdAt], map: "Notification_sweep_idx")
}

/// Per-`(userId, topic)` mute toggle for notification dispatches
/// (Phase 9.4). The table only stores **opt-outs** — the absence of
/// a row means "default, not muted". `NotificationsService.dispatch`
/// consults this table before persisting the Notification row, so a
/// muted topic produces neither the in-app entry nor the email.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Free-form string matching the canonical `Notification.topic`
  /// taxonomy from Phase 8.2 (`bill.issued`, `ticket.opened`, etc.).
  /// Stored as VARCHAR rather than an enum so adding a topic later
  /// doesn't require a migration here.
  topic String @db.VarChar(120)

  /// TRUE for opt-outs; the dispatch gate keys off this column.
  /// Default TRUE so the row's presence == muted (an unmuted topic
  /// is the absence of a row).
  muted Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topic])
  @@index([userId])
}

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String  @db.VarChar(120) // e.g., "user.suspend", "bill.void"
  target    String? @db.VarChar(120) // resource ref, e.g., "User:abc123"
  meta      Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([target])
}

/// Persistent record of every webhook delivery from a payment provider.
/// `@@unique([provider, eventId])` short-circuits duplicate deliveries —
/// Stripe retries on non-2xx so idempotency is a real concern, not a
/// theoretical one.
model WebhookEvent {
  id          String             @id @default(cuid())
  provider    PaymentProvider
  /// Provider's event id (`evt_…` for Stripe). Unique per provider.
  eventId     String
  /// Event name, e.g. `checkout.session.completed`. Free-form per
  /// provider; we don't enum it.
  type        String             @db.VarChar(120)
  /// Full payload as received, after signature verification.
  payload     Json
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  status      WebhookEventStatus @default(RECEIVED)
  /// Set when `status = FAILED` — keeps the diagnostic on the row.
  error       String?            @db.VarChar(2000)

  @@unique([provider, eventId])
  @@index([provider, type, receivedAt])
  @@index([status, receivedAt])
}

/// Pre-signed-upload-backed image asset. Created PENDING when the API
/// hands out a signed PUT URL; flipped to UPLOADED once the confirm
/// endpoint HEAD-checks the bucket. DELETED is set by the GDPR/erasure
/// flow — the row stays for audit even after the S3 object is purged.
///
/// Existing `Campaign.photos` / `ServiceJob.proofPhotos` columns keep
/// holding URL strings; an asset's `publicUrl` is what the client
/// embeds. The MediaAsset row is the source of truth for ownership +
/// revocation, not for rendering — see `docs/specs/phase8-media-uploads.md`.
model MediaAsset {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  purpose MediaPurpose
  status  MediaStatus  @default(PENDING)

  /// "s3" today; reserved for future providers (e.g. cloudflare R2).
  provider String @default("s3") @db.VarChar(20)
  bucket   String @db.VarChar(120)
  key      String @db.VarChar(500)

  filename    String @db.VarChar(200)
  contentType String @db.VarChar(120)
  sizeBytes   Int    @default(0)

  /// Cached canonical URL clients embed. May be a public-read S3 path or
  /// a CDN-fronted URL — depends on deploy config. Stored so callers
  /// don't have to re-derive it from bucket + key.
  publicUrl String @db.VarChar(800)

  /// Phase 10.3 — populated by the image-processing worker once a
  /// 320px JPEG variant is in S3. Null while processing is in flight
  /// or for rows that pre-date the worker; clients fall back to
  /// `publicUrl` in that case.
  thumbnailUrl String? @db.VarChar(800)
  thumbnailKey String? @db.VarChar(500)

  /// Phase 10.3 — set when processing finishes regardless of
  /// outcome. Pair with `processingFailureReason` to tell success
  /// from rejection without joining the audit log.
  processedAt DateTime?

  /// Phase 10.3 — set on the failure path (oversize bytes after
  /// EXIF strip, or worker gave up past max attempts).
  processingFailureReason String? @db.VarChar(2000)

  uploadedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
  @@index([provider, bucket, key])
}

enum MediaPurpose {
  CAMPAIGN_PHOTO
  JOB_PROOF
}

enum MediaStatus {
  /// Signed PUT issued; client hasn't confirmed yet.
  PENDING
  /// Confirm endpoint HEAD-verified the object exists in S3.
  UPLOADED
  /// S3 object purged; row kept for audit / link integrity.
  DELETED
  /// Phase 10.3 — image processor rejected the bytes (exceeded
  /// MAX_UPLOAD_BYTES after EXIF strip, or processing failed past
  /// max retries). S3 source is purged; row stays for audit.
  REJECTED
}

/// Singleton config row (Phase 9.6). The literal `@default("singleton")`
/// id + `@id` constraint mean Prisma will refuse a second insert.
/// Reads always hit the row by id; writes are upserts so a missing
/// row (fresh install, bad seed) resolves on the first PUT.
model PlatformConfig {
  id String @id @default("singleton")

  /// Platform commission rate in basis points. 1000 = 10%. Bounds
  /// enforced at the Zod layer (`[0, 5000]` = 0–50%); anything
  /// outside that range almost certainly indicates a mistake.
  commissionBps Int @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
