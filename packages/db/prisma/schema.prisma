// Single source of truth for the data model. See packages/db/CLAUDE.md for
// rules — most importantly: migrations are forward-only, money is integer
// minor units + currency, every table has id/createdAt/updatedAt.

generator client {
  provider = "prisma-client-js"
  // Default output → @prisma/client's own node_modules/.prisma/client.
  // With pnpm this is the only setup that lets `Prisma.HouseGetPayload`,
  // `Prisma.validator` etc. resolve correctly from consumer packages.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums (mirrored in @repo/shared) ---------------------------

enum Role {
  ADMIN
  OWNER
  TENANT
  PARTNER
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED
}

enum RentCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum BillLineKind {
  RENT
  DEPOSIT
  UTILITY_ELECTRICITY
  UTILITY_WATER
  UTILITY_INTERNET
  UTILITY_OTHER
  SERVICE_FEE
  LATE_FEE
  ADJUSTMENT
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  VNPAY
  MOMO
  MANUAL
}

enum TicketStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketCategory {
  REPAIR
  REPORT
  COMPLAINT
  REQUEST
  OTHER
}

enum CampaignStatus {
  DRAFT
  PENDING
  LIVE
  CLOSED
  REJECTED
  EXPIRED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  RATED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

// ---------- Core identity ----------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified Boolean   @default(false)
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  displayName   String    @db.VarChar(120)
  image         String?
  roles         Role[]    @default([])
  kycStatus     KycStatus @default(NONE)
  isSuspended   Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Better-Auth artifacts
  sessions      Session[]
  accounts      Account[]
  verifications Verification[]

  // Domain relations
  ownedHouses    House[]         @relation("HouseOwner")
  tenantLeases   Lease[]         @relation("LeaseTenant")
  ownerLeases    Lease[]         @relation("LeaseOwner")
  applications   Application[]
  ticketsRaised  Ticket[]        @relation("TicketReporter")
  ticketsAssigned Ticket[]       @relation("TicketAssignee")
  partnerProfile PartnerProfile?
  notifications  Notification[]
  auditLog       AuditLog[]

  @@index([deletedAt])
  @@index([createdAt])
}

// Better-Auth session storage. Refresh-token rotation happens here.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// OAuth / OTP provider account links. Kept generic for Better-Auth.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Short-lived verification artifacts (OTP codes, magic-link tokens).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier, value])
  @@index([expiresAt])
}

// ---------- Property domain --------------------------------------------

model House {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("HouseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(2000)

  // Address (denormalized JSON for v1; can be normalized later if needed)
  addressLine1 String  @db.VarChar(200)
  addressLine2 String? @db.VarChar(200)
  city         String  @db.VarChar(100)
  state        String? @db.VarChar(100)
  postalCode   String? @db.VarChar(20)
  country      String  @db.Char(2)

  lat Float?
  lng Float?

  isPublished Boolean @default(false)

  units Unit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId, deletedAt])
  @@index([country, city])
  @@index([isPublished, deletedAt])
}

model Unit {
  id     String     @id @default(cuid())
  houseId String
  house   House      @relation(fields: [houseId], references: [id], onDelete: Cascade)
  label   String     @db.VarChar(60)
  status  UnitStatus @default(VACANT)
  floor   Int?
  sqm     Int?
  bedrooms Int?
  bathrooms Int?

  leases    Lease[]
  campaigns Campaign[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([houseId, label])
  @@index([status])
}

model Lease {
  id        String      @id @default(cuid())
  unitId    String
  unit      Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenantId  String
  tenant    User        @relation("LeaseTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  ownerId   String
  owner     User        @relation("LeaseOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  status        LeaseStatus @default(DRAFT)
  rentCycle     RentCycle   @default(MONTHLY)
  rentAmount    Int         // minor units
  depositAmount Int         // minor units
  currency      String      @db.Char(3)

  startDate DateTime
  endDate   DateTime?

  bills Bill[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, status])
  @@index([ownerId, status])
  @@index([unitId, status])
}

// ---------- Billing & payments -----------------------------------------

model Bill {
  id      String     @id @default(cuid())
  leaseId String
  lease   Lease      @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime
  issuedAt    DateTime?

  status   BillStatus @default(DRAFT)
  subtotal Int        // minor units
  total    Int        // minor units (subtotal + line adjustments)
  currency String     @db.Char(3)

  lines    BillLine[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseId, status])
  @@index([status, dueDate])
}

model BillLine {
  id       String       @id @default(cuid())
  billId   String
  bill     Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  kind     BillLineKind
  label    String       @db.VarChar(200)
  amount   Int          // minor units (can be negative for adjustments)
  quantity Int          @default(1)
  meta     Json?

  createdAt DateTime @default(now())

  @@index([billId])
}

model Payment {
  id        String          @id @default(cuid())
  billId    String
  bill      Bill            @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount    Int             // minor units
  currency  String          @db.Char(3)
  status    PaymentStatus   @default(PENDING)
  provider  PaymentProvider
  providerRef String?       // Stripe payment intent id, etc.
  failureReason String?     @db.VarChar(500)
  receivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerRef])
  @@index([billId, status])
  @@index([status])
}

// ---------- Tickets ----------------------------------------------------

model Ticket {
  id         String         @id @default(cuid())
  reporterId String
  reporter   User           @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee   User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  category  TicketCategory
  status    TicketStatus   @default(OPEN)
  title     String         @db.VarChar(200)
  body      String         @db.VarChar(4000)

  resolvedAt DateTime?
  closedAt   DateTime?

  serviceJobs ServiceJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([reporterId, status])
  @@index([assigneeId, status])
  @@index([status, createdAt])
}

// ---------- Campaigns & applications -----------------------------------

model Campaign {
  id        String         @id @default(cuid())
  unitId    String
  unit      Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)

  title     String         @db.VarChar(200)
  body      String         @db.VarChar(4000)
  price     Int            // minor units
  currency  String         @db.Char(3)
  status    CampaignStatus @default(DRAFT)
  publishedAt DateTime?
  expiresAt   DateTime?

  applications Application[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, publishedAt])
  @@index([unitId, status])
}

model Application {
  id         String            @id @default(cuid())
  campaignId String
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  applicantId String
  applicant  User              @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  status     ApplicationStatus @default(SUBMITTED)
  message    String?           @db.VarChar(2000)
  decidedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, applicantId])
  @@index([applicantId, status])
  @@index([campaignId, status])
}

// ---------- Partner marketplace ----------------------------------------

model PartnerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String  @db.VarChar(200)
  bio          String? @db.VarChar(2000)
  serviceArea  String? @db.VarChar(500) // free-form for v1; later GIS

  kycStatus KycStatus @default(NONE)

  services Service[]
  jobs     ServiceJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Service {
  id        String         @id @default(cuid())
  partnerId String
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(200)
  description String? @db.VarChar(2000)
  basePrice   Int     // minor units
  currency    String  @db.Char(3)
  isActive    Boolean @default(true)

  jobs ServiceJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([partnerId, isActive])
}

model ServiceJob {
  id        String    @id @default(cuid())
  partnerId String
  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  serviceId String?
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  ticketId  String?
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  status        JobStatus @default(REQUESTED)
  quotedAmount  Int?      // minor units
  finalAmount   Int?
  currency      String?   @db.Char(3)

  cancelReason  String?   @db.VarChar(200)
  scheduledFor  DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, status])
  @@index([ticketId])
  @@index([status, createdAt])
}

// ---------- Cross-cutting ----------------------------------------------

model Notification {
  id      String              @id @default(cuid())
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  topic   String              @db.VarChar(120)
  title   String              @db.VarChar(200)
  body    String?             @db.VarChar(2000)
  data    Json?
  readAt  DateTime?
  sentAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(120) // e.g., "user.suspend", "bill.void"
  target    String?  @db.VarChar(120) // resource ref, e.g., "User:abc123"
  meta      Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([target])
}
