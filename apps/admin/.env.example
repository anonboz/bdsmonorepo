# apps/admin/.env.example
#
# Per ADR-0001 (subdomain-per-role), this PWA deploys to
# admin.<platform-domain> and talks to api.<platform-domain>.
# Admin is the most sensitive surface — isolating it to its own
# subdomain is part of the security posture (tighter CSP, separate
# observability scope, scoped cookie auth via the shared parent
# domain).

NEXT_PUBLIC_API_URL=http://localhost:4001
# Production: NEXT_PUBLIC_API_URL=https://api.bdsmonorepo.vn

NEXT_PUBLIC_APP_NAME="BDS Admin"
