# Connection string for the test DB. **THIS DB IS WIPED** by
# global-setup.ts before every run — never point it at anything that
# matters. Defaults to the local docker-compose dev DB.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Base URL of the API the suite drives. Defaults to the local API.
API_BASE_URL=http://localhost:3001

# The auth helper logs in many times across the suite; the send-otp
# per-route limit (5/min, see apps/api/src/main.ts) would turn that
# into a 429 cascade. Set this when invoking `pnpm test:e2e` locally:
#
#   API_DISABLE_RATE_LIMIT=true DATABASE_URL=... pnpm test:e2e
#
# CI sets it via the workflow env block.
API_DISABLE_RATE_LIMIT=true
