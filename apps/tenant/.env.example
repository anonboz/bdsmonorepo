# apps/tenant/.env.example
#
# Per ADR-0001 (subdomain-per-role), this PWA deploys to
# tenant.<platform-domain> and talks to api.<platform-domain>.

NEXT_PUBLIC_API_URL=http://localhost:4001
# Production: NEXT_PUBLIC_API_URL=https://api.bdsmonorepo.vn

NEXT_PUBLIC_APP_NAME="BDS Tenant"

# Phase 12.6 — surface phone + password login and the set-password screen.
# Keep off until the API credential provider is deployed; flip per-app.
NEXT_PUBLIC_AUTH_PASSWORD_ENABLED=false
