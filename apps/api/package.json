    "rxjs": "^7.8.1",
    "stripe": "^22.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^20.16.13",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.13.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.13.0",
