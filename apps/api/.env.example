# apps/api/.env.example
#
# Copy to apps/api/.env and fill in the secrets for your environment.
# Per ADR-0001 (subdomain-per-role), production deploys each PWA + the
# API to its own subdomain of the platform domain.
#
# Replace `bdsmonorepo.vn` with the real registered domain at cutover.

# ---- Runtime ---------------------------------------------------------

NODE_ENV=development
API_PORT=4001
API_PUBLIC_URL=http://localhost:4001
# Production: API_PUBLIC_URL=https://api.bdsmonorepo.vn

# CORS allow-list (CSV). Local dev = the four PWA dev ports.
# Production = the four subdomain origins; add a wildcard for Vercel
# preview deploys if those need to talk to a staging API.
API_CORS_ORIGINS=http://localhost:4000,http://localhost:4010,http://localhost:4020,http://localhost:4030
# Production: API_CORS_ORIGINS=https://admin.bdsmonorepo.vn,https://owner.bdsmonorepo.vn,https://tenant.bdsmonorepo.vn,https://partner.bdsmonorepo.vn

# Per-PWA origins. Used in server-side link composition (Stripe /
# VNPay / MoMo return URLs, future cross-app deep links, etc.).
TENANT_APP_URL=http://localhost:4020
OWNER_APP_URL=http://localhost:4010
PARTNER_APP_URL=http://localhost:4030
ADMIN_APP_URL=http://localhost:4000
# Production: TENANT_APP_URL=https://tenant.bdsmonorepo.vn
#             OWNER_APP_URL=https://owner.bdsmonorepo.vn
#             PARTNER_APP_URL=https://partner.bdsmonorepo.vn
#             ADMIN_APP_URL=https://admin.bdsmonorepo.vn

# ---- Auth ------------------------------------------------------------

AUTH_SECRET=change-me-to-at-least-32-chars-of-entropy
AUTH_JWT_ACCESS_TTL=900
AUTH_JWT_REFRESH_TTL=2592000
# Local dev: bare hostname so cookies stay on localhost:* only.
# Production: leading-dot parent domain so one session crosses all
# four subdomains (per ADR-0001 + better-auth's crossSubDomainCookies).
AUTH_COOKIE_DOMAIN=localhost
# Production: AUTH_COOKIE_DOMAIN=.bdsmonorepo.vn

# ---- Database / cache ------------------------------------------------

DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# ---- Email -----------------------------------------------------------

EMAIL_FROM="BDS <no-reply@bdsmonorepo.vn>"
# Local dev uses MailHog (SMTP on :1025). Production sets RESEND_API_KEY.
SMTP_HOST=localhost
SMTP_PORT=1025
# RESEND_API_KEY=re_...

# ---- Payments --------------------------------------------------------

# Stripe (international rail) — phase 7.2
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# VNPay (VN bank cards / QR) — phase 7.4
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# Production swaps to https://pay.vnpay.vn/vpcpay.html
# VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# MoMo (VN e-wallet) — phase 12.1
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# Production swaps to https://payment.momo.vn/v2/gateway/api/create
# MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create

# ---- Storage ---------------------------------------------------------

# Local MinIO defaults (see docker-compose.yml).
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=bds-local
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin

# ---- Push / SMS / Observability -------------------------------------

# Web push (phase 10.5)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@bdsmonorepo.vn

# SMS OTP (phase 11.6) — esms.vn (Speedio)
# SMS_PROVIDER=mock | esms-vn
# ESMS_VN_API_KEY=
# ESMS_VN_SECRET_KEY=
# ESMS_VN_BRAND_NAME=BDS

# Sentry / PostHog (no defaults — leave unset locally)
# SENTRY_DSN=
# POSTHOG_API_KEY=
