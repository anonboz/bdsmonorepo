# --- Core ---------------------------------------------------------------
NODE_ENV=development

# --- API ----------------------------------------------------------------
API_PORT=4001
API_PUBLIC_URL=http://localhost:4001
API_CORS_ORIGINS=http://localhost:4000,http://localhost:4010,http://localhost:4020,http://localhost:4030

# --- Database -----------------------------------------------------------
# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# --- Redis / queues -----------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 / MinIO local) ---------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_UPLOADS=bds-uploads
S3_BUCKET_RECEIPTS=bds-receipts
S3_FORCE_PATH_STYLE=true

# --- Auth (Better-Auth) ------------------------------------------------
AUTH_SECRET=replace-me-with-a-32-byte-secret
AUTH_JWT_ACCESS_TTL=900       # seconds
AUTH_JWT_REFRESH_TTL=2592000  # seconds
AUTH_COOKIE_DOMAIN=localhost

# --- Email (Resend in prod, MailHog locally) ---------------------------
EMAIL_FROM="BDS <no-reply@localhost>"
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Payments ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# --- Observability ------------------------------------------------------
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.posthog.com

# --- Frontends (per app) -----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
