# House-Renting monorepo — copy to .env and fill in.

# --- Database (Prisma 7 + pg adapter) -----------------------------------
# DATABASE_URL: pooled connection used by the runtime PrismaClient (pg pool).
# DIRECT_URL:   NON-pooled direct connection used ONLY by the Prisma CLI for
#               migrations (needs DDL locks + shadow DB). Supabase: :5432 direct.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/house_renting?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/house_renting?schema=public"

# --- Auth (NextAuth 4, JWT sessions) ------------------------------------
# 32+ byte secret. Per-app cookie names are set in each app's lib/session.ts.
NEXTAUTH_SECRET="replace-me-with-a-32-byte-secret"
NEXTAUTH_URL="http://localhost:6100"

# --- Realtime (Pusher Channels + Beams) ---------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Storage (Supabase Storage — landlord app, meter-reading photos) ----
# Same Supabase project as DATABASE_URL/DIRECT_URL. SUPABASE_SERVICE_ROLE_KEY
# is a secret (Project Settings > API in the Supabase dashboard) — server-side
# only, never expose to the client. Requires a public "meter-readings" bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
