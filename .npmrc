auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
prefer-workspace-packages=true
link-workspace-packages=true
save-workspace-protocol=rolling
# engine-strict left off — pnpm 9 enforces dep engines under it, and some
# transitive deps (notably better-auth → better-call wanting zod ^4) break
# CI even though local install warns rather than errors.
